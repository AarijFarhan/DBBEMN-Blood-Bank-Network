# ---------------------------------------------------------------------------
# DBBEMN backend configuration. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------------------

PORT=8080
INSTANCE_ID=dev-local
FRONTEND_DIST=../frontend/dist
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Required, min 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Business rules
DONATION_INTERVAL_DAYS=90
HOLD_MINUTES=30
CRITICAL_HOLD_MINUTES=60
REPLICA_LAG_MS=750
SEARCH_SHARD_TIMEOUT_MS=1500

# ---------------------------------------------------------------------------
# Database topology
# ---------------------------------------------------------------------------
# single      one PostgreSQL instance holds catalog, common and all 3 city
#             schemas. This is the default when DB_MODE is unset and only
#             DATABASE_URL is provided.
# distributed 4 instances: one catalog node + one node per city.
#
# Leave DB_MODE unset for the original single-node setup. Set it to
# "distributed" only after `docker compose up -d` succeeds.

# DB_MODE=single

# --- single-node mode -------------------------------------------------------
# Required in single mode. Leave this the ONLY database URL you set: the four
# URLs below are all commented out by default, so a fresh copy of this file
# stays in single mode. If they were all set at once, mode detection would see
# the per-city URLs and switch to distributed even with DB_MODE unset.
DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5432/dbbemn

# --- distributed mode -------------------------------------------------------
# To switch over: start the containers, then uncomment ALL FOUR of these AND
# set DB_MODE=distributed. All four are required; partial config is rejected
# rather than silently falling back. Host ports must match docker-compose.yml
# (catalog defaults to 5436).
#
# DB_MODE=distributed
# CATALOG_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5436/dbbemn
# KHI_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5433/dbbemn
# LHE_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5434/dbbemn
# ISB_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5435/dbbemn

# ---------------------------------------------------------------------------
# Cache and presence filters (all optional)
# ---------------------------------------------------------------------------
# The API is fully functional with none of these set. Without REDIS_URL it uses a
# bounded in-memory cache, which is correct for a single API instance but NOT for
# several: a version bump on one instance cannot invalidate another's cache, so
# set REDIS_URL before scaling out. The same applies to logout, where a revocation
# recorded on one instance would be invisible to the others.
#
# Redis is also how the Bloom filters are shared. Without it they are per-process
# and untrusted until rebuilt, so cross-shard lookups fall back to scanning every
# city — correct, just not faster.
#
# REDIS_URL=redis://localhost:6379
# CACHE_KEY_PREFIX=dbbemn
# CACHE_ENABLED=true
# CACHE_SEARCH_TTL=10
# CACHE_SUMMARY_TTL=20
# CACHE_DIRECTORY_TTL=60
# CACHE_MEMORY_MAX_ENTRIES=5000

# --- Bloom filters ----------------------------------------------------------
# A Bloom filter can say "definitely absent" but never "definitely present", so it
# is used only to skip shards that cannot hold a record. Filters are rebuilt from
# the tables at boot; a failed insert or a stale mutation counter marks a filter
# untrusted, and an untrusted filter is simply not consulted.
#
# Sizing only affects the false-positive rate, never correctness. Set this to your
# expected row count per city per table.
#
# BLOOM_ENABLED=true
# BLOOM_EXPECTED_ITEMS=50000
# BLOOM_ERROR_RATE=0.001

# docker-compose port overrides, only if you changed them there
# POSTGRES_USER=dbbemn
# POSTGRES_PASSWORD=dbbemn
# POSTGRES_DB=dbbemn
# CATALOG_PORT=5436
# KHI_PORT=5433
# LHE_PORT=5434
# ISB_PORT=5435
