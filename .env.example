# ---------------------------------------------------------------------------
# DBBEMN backend configuration. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------------------

PORT=8080
INSTANCE_ID=dev-local
FRONTEND_DIST=../frontend/dist
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Required, min 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Business rules
DONATION_INTERVAL_DAYS=90
HOLD_MINUTES=30
CRITICAL_HOLD_MINUTES=60
REPLICA_LAG_MS=750
SEARCH_SHARD_TIMEOUT_MS=1500
# Must stay below nginx's 60-second proxy timeout so slow shards return partial stats.
STATS_SHARD_TIMEOUT_MS=45000
# Worker launch scripts run maintenance only on worker-1. Set false to disable it.
BACKGROUND_JOBS_ENABLED=true

# ---------------------------------------------------------------------------
# Database topology
# ---------------------------------------------------------------------------
# single      one PostgreSQL instance holds catalog, common and all city
#             schemas. This is the default when DB_MODE is unset and only
#             DATABASE_URL is provided.
# distributed one catalog node + one node per city (CITY_CODES).
#
# Leave DB_MODE unset for the original single-node setup. Set it to
# "distributed" only after `docker compose up -d` succeeds.

# DB_MODE=single

# --- single-node mode -------------------------------------------------------
# Required in single mode. Leave this the ONLY database URL you set: the city
# URLs below are all commented out by default, so a fresh copy of this file
# stays in single mode. If they were all set at once, mode detection would see
# the per-city URLs and switch to distributed even with DB_MODE unset.
DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5432/dbbemn

# --- distributed mode -------------------------------------------------------
# To switch over: start the containers, then uncomment ALL of these AND
# set DB_MODE=distributed. All are required; partial config is rejected
# rather than silently falling back. One URL per entry in CITY_CODES.
#
# DB_MODE=distributed
# CATALOG_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5436/dbbemn
# KHI_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5433/dbbemn
# LHE_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5434/dbbemn
# ISB_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5435/dbbemn
# RWP_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5437/dbbemn
# FSD_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5438/dbbemn
# MUL_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5439/dbbemn
# PEW_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5440/dbbemn
# QUE_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5441/dbbemn
# HYD_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5442/dbbemn
# GUJ_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5443/dbbemn

# Optional physical PostgreSQL standby URLs for real replica monitoring.
# Configure an actual streaming standby for each URL; the application probes it
# but does not create or manage PostgreSQL replication. Do not point these at the
# primary URL: a city database is monitored as a primary, not as its own standby.
# CATALOG_REPLICA_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5546/dbbemn
# KHI_REPLICA_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5553/dbbemn
# LHE_REPLICA_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5554/dbbemn
# ISB_REPLICA_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5555/dbbemn
# RWP_REPLICA_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5557/dbbemn
# FSD_REPLICA_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5558/dbbemn
# MUL_REPLICA_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5559/dbbemn
# PEW_REPLICA_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5560/dbbemn
# QUE_REPLICA_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5561/dbbemn
# HYD_REPLICA_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5562/dbbemn
# GUJ_REPLICA_DATABASE_URL=postgresql://dbbemn:dbbemn@localhost:5563/dbbemn

# ---------------------------------------------------------------------------
# Cache and presence filters (all optional)
# ---------------------------------------------------------------------------
# The API is fully functional with none of these set. Without REDIS_URL it uses a
# bounded in-memory cache, which is correct for a single API instance but NOT for
# several: a version bump on one instance cannot invalidate another's cache, so
# set REDIS_URL before scaling out. The same applies to logout, where a revocation
# recorded on one instance would be invisible to the others.
#
# Redis is also how the Bloom filters are shared. Without it they are per-process
# and untrusted until rebuilt, so cross-shard lookups fall back to scanning every
# city — correct, just not faster.
#
# REDIS_URL=redis://localhost:6379
# CACHE_KEY_PREFIX=dbbemn
# CACHE_ENABLED=true
# CACHE_SEARCH_TTL=10
# CACHE_SUMMARY_TTL=20
# CACHE_DIRECTORY_TTL=60
# CACHE_MEMORY_MAX_ENTRIES=5000

# --- Bloom filters ----------------------------------------------------------
# A Bloom filter can say "definitely absent" but never "definitely present", so it
# is used only to skip shards that cannot hold a record. Filters are rebuilt from
# the tables at boot; a failed insert or a stale mutation counter marks a filter
# untrusted, and an untrusted filter is simply not consulted.
#
# Sizing only affects the false-positive rate, never correctness. Set this to your
# expected row count per city per table.
#
# BLOOM_ENABLED=true
# BLOOM_EXPECTED_ITEMS=50000
# BLOOM_ERROR_RATE=0.001

# docker-compose port overrides, only if you changed them there
# POSTGRES_USER=dbbemn
# POSTGRES_PASSWORD=dbbemn
# POSTGRES_DB=dbbemn
# CATALOG_PORT=5436
# KHI_PORT=5433
# LHE_PORT=5434
# ISB_PORT=5435
# RWP_PORT=5437
# FSD_PORT=5438
# MUL_PORT=5439
# PEW_PORT=5440
# QUE_PORT=5441
# HYD_PORT=5442
# GUJ_PORT=5443
