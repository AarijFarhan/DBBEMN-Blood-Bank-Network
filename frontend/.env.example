# DBBEMN frontend configuration. Copy to .env to override locally.
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# Base URL for all API calls. Accepts either a bare origin or a full path ending
# in /api/v1. Falls back to https://dbbemn-blood-bank-network.onrender.com/api/v1
# when unset, so Vercel builds need no configuration.
# Examples:
#   https://dbbemn-blood-bank-network.onrender.com
#   http://localhost
VITE_API_URL=

# Optional Vite dev-server proxy target. Defaults to the local gateway on port 80.
# Use http://localhost:8080 when running only the standalone backend instead.
VITE_API_PROXY_TARGET=http://127.0.0.1
