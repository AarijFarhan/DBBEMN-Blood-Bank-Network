{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs=require('node:fs'); if (!(process.env.npm_config_user_agent || '').startsWith('pnpm/')) { console.error('Use pnpm instead'); process.exit(1); } for (const file of ['package-lock.json','yarn.lock']) fs.rmSync(file, { force: true });\"",
    "start": "node --env-file-if-exists=.env ./scripts/start.js",
    "start:backend": "node --env-file-if-exists=.env ./backend/src/index.js",
    "start:gateway": "node --env-file-if-exists=.env ./gateway/gateway.js",
    "dev": "node --env-file-if-exists=.env ./scripts/dev.js",
    "dev:backend": "node --env-file-if-exists=.env --watch ./backend/src/index.js",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "migrate": "node --env-file-if-exists=.env ./scripts/migrate.js",
    "migrate:isolated": "node --env-file-if-exists=.env ./scripts/run-db-command.js migrate.js t_",
    "migrate:phase3": "node --env-file-if-exists=.env ./scripts/run-db-command.js migrate.js p3_",
    "seed": "node --env-file-if-exists=.env ./scripts/seed-large.js",
    "seed:large": "node --env-file-if-exists=.env ./scripts/seed-large.js",
    "seed:small": "node --env-file-if-exists=.env ./scripts/seed.js",
    "seed:small:isolated": "node --env-file-if-exists=.env ./scripts/run-db-command.js seed.js t_",
    "seed:small:phase3": "node --env-file-if-exists=.env ./scripts/run-db-command.js seed.js p3_",
    "verify:invariants": "node --env-file-if-exists=.env ./scripts/verify-invariants.js",
    "verify:invariants:isolated": "node --env-file-if-exists=.env ./scripts/run-db-command.js verify-invariants.js t_",
    "verify:phase1": "node --env-file-if-exists=.env ./scripts/verify-phase1.js",
    "verify:phase1:isolated": "node --env-file-if-exists=.env ./scripts/run-db-command.js verify-phase1.js t_",
    "test": "node --env-file-if-exists=.env ./scripts/test-all.js",
    "test:clean": "node --env-file-if-exists=.env ./scripts/test-all.js",
    "test:all": "node --env-file-if-exists=.env ./scripts/test-all.js",
    "test:phase1": "node --env-file-if-exists=.env ./scripts/run-test.js phase1",
    "test:phase2": "node --env-file-if-exists=.env ./scripts/run-test.js phase2",
    "test:phase3": "node --env-file-if-exists=.env ./scripts/run-test.js phase3",
    "loadtest:mixed": "node --env-file-if-exists=.env ./scripts/loadtest/mixed.js",
    "loadtest:contention": "node --env-file-if-exists=.env ./scripts/loadtest/contention.js",
    "bootstrap:admin": "node --env-file-if-exists=.env ./scripts/bootstrap-admin.js"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
